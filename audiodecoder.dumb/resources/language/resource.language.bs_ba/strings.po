msgctxt "Addon Summary"
msgid "Dynamic Universal Music Bibliotheque"
msgstr "Dinamična univerzalna muzička biblioteka"

msgctxt "Addon Description"
msgid "DUMB is a module audio renderer library. It reads module files and outputs audio that can be dumped to the actual audio playback library.[CR][CR]On Kodi Supports playback of the following module formats:[CR]- IT (Impulse Tracker)[CR]- XM (Fasttracker II)[CR]- S3M (Scream Tracker 3)"
msgstr "DUMB je biblioteka za renderiranje zvuka modula. Čita datoteke modula i reproducira zvuk koji se može prenijeti u stvarnu biblioteku za reprodukciju zvuka.[CR][CR]Na Kodiju podržava reprodukciju sljedećih formata modula:[CR]- IT (Impulse Tracker)[CR]- XM (Fasttracker II)[CR]- S3M (Scream Tracker 3)"

msgctxt "Addon Disclaimer"
msgid "It is recommended to use \"OpenMPT Audio Decoder\" addon instead of this one."
msgstr "Preporučuje se korištenje dodatka \"OpenMPT Audio Decoder\" umjesto ovog."

msgctxt "Addon Lifecyclestate"
msgid "Replaced by audiodecoder.openmpt addon! However, but still usable here."
msgstr "Zamijenjeno dodatkom audiodecoder.openmpt! Međutim, i dalje se može koristiti ovdje."
